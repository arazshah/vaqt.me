# محیط اجرا (development | production)
NODE_ENV=development

# پورت API
PORT=3001

# آدرس وب (برای CORS)
WEB_ORIGIN=http://localhost:3000

# دیتابیس PostgreSQL
DATABASE_URL=postgresql://vaqt:vaqt@localhost:5432/vaqt

# Redis
REDIS_URL=redis://localhost:6380
# پیشوند تمام کلیدهای Redis (جداسازی namespace در محیط‌های مختلف)
REDIS_PREFIX=vaqt:dev:

# JWT Secrets (در production مقادیر تصادفی قوی استفاده کنید)
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
# طول عمر access token و refresh token بر حسب ثانیه (پیش‌فرض: ۱۵ دقیقه / ۳۰ روز)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# pepper سرور برای هش HMAC-SHA256 کد OTP (هرگز خالی یا پیش‌فرض در production)
OTP_PEPPER=change-me-in-production
# مدت اعتبار کد OTP بر حسب ثانیه
OTP_TTL_SECONDS=120
# کد ثابت OTP فقط برای تست‌های e2e — هرگز در production ست نشود
DEV_FIXED_OTP=

# فاصله‌ی حداقلی بین دو ارسال مجدد OTP برای یک شماره (ثانیه)
RATE_LIMIT_RESEND_COOLDOWN_SECONDS=60
# حداکثر تعداد ارسال مجدد یک کد OTP یکسان
RATE_LIMIT_MAX_RESEND_PER_CODE=3
# حداکثر تلاش برای تأیید هر کد OTP
RATE_LIMIT_MAX_VERIFY_ATTEMPTS=5
# سقف درخواست OTP برای هر شماره (ساعتی / روزانه)
RATE_LIMIT_PHONE_HOURLY=5
RATE_LIMIT_PHONE_DAILY=10
# سقف درخواست OTP برای هر IP (ساعتی / روزانه)
RATE_LIMIT_IP_HOURLY=15
RATE_LIMIT_IP_DAILY=40
# تعداد کد باطل‌شده‌ی متوالی که باعث بلاک‌شدن شماره می‌شود
RATE_LIMIT_INVALIDATED_STREAK_THRESHOLD=3
# مدت بلاک‌شدن شماره پس از عبور از آستانه‌ی بالا (ثانیه)
RATE_LIMIT_BLOCK_SECONDS=1800

# مدت کش وضعیت تأیید شماره در Redis برای گارد RequireVerifiedPhone (ثانیه)
VERIFIED_PHONE_CACHE_TTL_SECONDS=30
# مدت اعتبار تیکت یک‌بارمصرف اتصال WebSocket (ثانیه)
WS_TICKET_TTL_SECONDS=60

# ارائه‌دهنده پیامک (mock | smsir)
SMS_PROVIDER=mock
SMSIR_API_KEY=
SMSIR_VERIFY_TEMPLATE_ID=

# ارائه‌دهنده پرداخت (mock | zarinpal)
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:3001/api/v1/payments/zarinpal/callback

# ارائه‌دهنده AI (mock | anthropic | openai)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022

# ارائه‌دهنده ذخیره‌سازی فایل آواتار (local | s3)
STORAGE_PROVIDER=local
# فقط برای local: مسیر ذخیره فایل‌ها روی دیسک و آدرس عمومی سرو استاتیک آن‌ها
LOCAL_STORAGE_DIR=./uploads
LOCAL_STORAGE_PUBLIC_URL=http://localhost:3001/uploads
# فقط برای s3 (سازگار با آروان کلود): endpoint، region، نام باکت، کلیدها و آدرس عمومی فایل‌ها
S3_ENDPOINT=
S3_REGION=default
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
