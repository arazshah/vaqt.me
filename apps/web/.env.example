# محیط اجرا (development | production)
NODE_ENV=development

# آدرس API
NEXT_PUBLIC_API_URL=http://localhost:3001

# آدرس همین وب‌اپ — فقط برای درخواست‌های سمت سرور (generateMetadata،
# opengraph-image) که باید هدر Origin را دستی ست کنند، چون بدون مرورگر
# هیچ Origin خودکاری وجود ندارد و origin-check.middleware سمت API هر
# POST را بدون آن رد می‌کند. باید دقیقاً با WEB_ORIGIN سمت apps/api یکی باشد.
WEB_ORIGIN=http://localhost:3000
