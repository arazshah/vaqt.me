{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@vaqt/db", "@vaqt/db/*"],
            "message": "apps/web must never talk to the database directly — go through the API instead."
          }
        ]
      }
    ]
  }
}
