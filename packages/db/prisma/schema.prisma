// Prisma Schema for Vaqt.me — Phase 1
//
// Enum source of truth lives in packages/shared/src/constants/enums.ts.
// This file mirrors those values exactly; packages/db has a unit test
// (src/__tests__/enums.test.ts) asserting they never drift apart.
//
// `output` is set to a package-local path (see generator block below).
// Without it, Prisma 6 writes the client into pnpm's content-addressed
// store (node_modules/.pnpm/@prisma+client@<hash>/...), a path outside
// this package's directory and outside turbo's default input/output
// scanning root — turbo has no way to know the client exists, is fresh,
// or is even present, so it can restore a "successful" typecheck/test
// cache hit from a run where the client existed even after a fresh
// `pnpm install --ignore-scripts` left no client on disk at all. A
// package-local output makes the generated client a trackable file this
// package owns, so turbo.json can declare it as the `generate` task's
// real `outputs` and downstream tasks pick up its hash. Verified live
// with Prisma 6.19.3 + pnpm 9.15.4 (2026-08-21): the generated client
// types correctly (not `any`) — a deliberately invalid field on
// `prisma.user.findUnique` fails `tsc` exactly as it should. Also
// verified: `packages/db/tsup.config.ts` externalizes this path and
// declarations are emitted by plain `tsc`, not tsup's `dts` bundler —
// see the comment there for why.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (mirror of packages/shared/src/constants/enums.ts)
// ---------------------------------------------------------------------------

enum RoleIntent {
  SEEKER
  PROVIDER
  BOTH
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  AUTH
}

enum RequestMode {
  ONLINE
  IN_PERSON
  HYBRID
}

enum RequestStatus {
  DRAFT
  PUBLISHED
  OFFER_SELECTED
  CLOSED
  EXPIRED
  REMOVED
}

enum Currency {
  IRR
}

enum OfferStatus {
  PENDING
  SELECTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ConversationStatus {
  OPEN
  ARCHIVED
}

enum MessageType {
  TEXT
  SYSTEM
}

enum ProductCode {
  URGENT_BADGE
  BUMP
  FEATURE
  PRO_MONTHLY
  TARGETED_NOTIFY
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentProvider {
  ZARINPAL
  MOCK
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum NotificationChannel {
  IN_APP
  SMS
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

// Permission level — distinct from RoleIntent (SEEKER/PROVIDER/BOTH is
// product intent a user can freely change, never a permission grant).
enum SystemRole {
  USER
  ADMIN
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                 String       @id @default(cuid())
  phone              String       @unique
  // Public card address vaqt.me/<username>; lowercase, null until claimed.
  username           String?      @unique
  phoneVerifiedAt    DateTime?
  displayName        String
  avatarUrl          String?
  avatarThumbnailUrl String?
  // Storage adapter key for the current avatar (e.g. local disk path or S3
  // object key) — internal only, never serialized via toPublicUser().
  avatarStorageKey   String?
  bio                String?
  headline           String?
  city               String?
  modePreference     RequestMode?
  linkedinUrl        String?
  timezone           String       @default("Asia/Tehran")
  ratingAvg          Float        @default(0)
  ratingCount        Int          @default(0)
  roleIntent         RoleIntent   @default(SEEKER)
  systemRole         SystemRole   @default(USER)
  status             UserStatus   @default(ACTIVE)
  lastSeenAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  requestsOwned           Request[]               @relation("RequestOwner")
  offers                  Offer[]                 @relation("OfferProvider")
  aiSessions              AiSession[]
  sentMessages            Message[]               @relation("MessageSender")
  conversationsAsSeeker   Conversation[]          @relation("ConversationSeeker")
  conversationsAsProvider Conversation[]          @relation("ConversationProvider")
  reviewsWritten          Review[]                @relation("ReviewReviewer")
  reviewsReceived         Review[]                @relation("ReviewReviewee")
  orders                  Order[]
  entitlements            Entitlement[]
  subscriptions           Subscription[]
  notifications           Notification[]
  reportsFiled            Report[]                @relation("ReportReporter")
  reportsAgainst          Report[]                @relation("ReportTargetUser")
  auditLogs               AuditLog[]
  sessions                Session[]
  skills                  UserSkill[]
  card                    Card?
  contactLinks            ContactLink[]
  serviceTypes            ServiceType[]
  availabilityRules       AvailabilityRule[]
  availabilityExceptions  AvailabilityException[]
  bookingsAsProvider      Booking[]               @relation("BookingProvider")
  bookingsAsBooker        Booking[]               @relation("BookingBooker")
  messengerBindings       MessengerBinding[]
  cardEvents              CardEvent[]
  savedCards              SavedCard[]             @relation("WalletOwner")
  savedByOthers           SavedCard[]             @relation("WalletCard")

  @@index([status])
  @@map("users")
}

model UserSkill {
  userId    String
  skillId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  familyId         String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  // Id of the session that superseded this one on rotation. Not a formal FK
  // (the replacement row is created before this row is updated), just an
  // audit trail for reuse-detection investigations.
  replacedById     String?

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model VerificationCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose @default(AUTH)
  attempts   Int        @default(0)
  // Number of times this exact code has been sent (original send = 1).
  // Capped at 3 by the service layer; resend never changes expiresAt.
  sendCount  Int        @default(1)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([phone])
  @@index([phone, purpose, consumedAt])
  @@map("verification_codes")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  order     Int        @default(0)
  // Soft-deactivate only — never hard-deleted. A category with any
  // non-terminal Request still pointing at it may not be deactivated (see
  // CategoriesAdminService).
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  requests Request[]
  skills   Skill[]

  @@index([parentId])
  @@map("categories")
}

model Skill {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  requestSkills RequestSkill[]
  userSkills    UserSkill[]

  @@index([categoryId])
  @@map("skills")
}

model Request {
  id               String        @id @default(cuid())
  slug             String        @unique
  ownerId          String
  owner            User          @relation("RequestOwner", fields: [ownerId], references: [id])
  title            String
  description      String
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  mode             RequestMode
  city             String?
  durationMinutes  Int
  budgetMinRial    Int
  budgetMaxRial    Int
  currency         Currency      @default(IRR)
  deadlineAt       DateTime
  preferredWindows Json
  status           RequestStatus @default(DRAFT)
  viewCount        Int           @default(0)
  offerCount       Int           @default(0)
  isUrgent         Boolean       @default(false)
  isFeatured       Boolean       @default(false)
  bumpedAt         DateTime?
  publishedAt      DateTime?

  // Persian full-text search: normalizeFa(title + ' ' + description),
  // written server-side only. GIN trigram index added via raw SQL in the
  // init migration (pg_trgm extension).
  searchText String @default("")

  // Server-computed listing rank — never settable from any input DTO.
  // ORDER BY listTier DESC, listRankAt DESC, id DESC
  listTier   Int      @default(0)
  listRankAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills        RequestSkill[]
  offers        Offer[]
  aiSessions    AiSession[]
  conversations Conversation[]
  orders        Order[]
  entitlements  Entitlement[]

  @@index([status])
  @@index([categoryId])
  @@index([mode])
  @@index([city])
  @@index([deadlineAt])
  @@index([ownerId])
  @@index([listTier, listRankAt, id])
  @@map("requests")
}

model RequestSkill {
  requestId String
  skillId   String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([requestId, skillId])
  @@index([skillId])
  @@map("request_skills")
}

model AiSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  requestId      String?
  request        Request? @relation(fields: [requestId], references: [id])
  messages       Json
  extractedDraft Json?
  tokensUsed     Int      @default(0)
  provider       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([requestId])
  @@map("ai_sessions")
}

model Offer {
  id                      String      @id @default(cuid())
  requestId               String
  request                 Request     @relation(fields: [requestId], references: [id])
  providerId              String
  provider                User        @relation("OfferProvider", fields: [providerId], references: [id])
  proposedStartAt         DateTime
  proposedDurationMinutes Int
  amountRial              Int
  message                 String?
  status                  OfferStatus @default(PENDING)
  // Bumped on every WITHDRAWN -> PENDING re-submit of the same
  // (requestId, providerId) pair, so the unique constraint below can stay
  // hard while still allowing a provider to try again.
  revisionCount           Int         @default(0)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  conversation Conversation?

  @@unique([requestId, providerId])
  @@index([providerId])
  @@index([status])
  @@map("offers")
}

model Conversation {
  id            String             @id @default(cuid())
  requestId     String
  request       Request            @relation(fields: [requestId], references: [id])
  offerId       String             @unique
  offer         Offer              @relation(fields: [offerId], references: [id])
  seekerId      String
  seeker        User               @relation("ConversationSeeker", fields: [seekerId], references: [id])
  providerId    String
  providerUser  User               @relation("ConversationProvider", fields: [providerId], references: [id])
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  messages Message[]
  reviews  Review[]

  @@index([seekerId])
  @@index([providerId])
  @@index([requestId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String?
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id])
  type           MessageType  @default(TEXT)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@map("messages")
}

model Review {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  reviewerId     String
  reviewer       User         @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  revieweeId     String
  reviewee       User         @relation("ReviewReviewee", fields: [revieweeId], references: [id])
  rating         Int
  comment        String?
  isVisible      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

model Product {
  id            String      @id @default(cuid())
  code          ProductCode @unique
  title         String
  description   String
  priceRial     Int
  durationHours Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orders Order[]

  @@map("products")
}

model Order {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  requestId  String?
  request    Request?        @relation(fields: [requestId], references: [id])
  amountRial Int
  status     OrderStatus     @default(PENDING)
  provider   PaymentProvider @default(MOCK)
  authority  String?         @unique
  refId      String?
  paidAt     DateTime?
  raw        Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  entitlements  Entitlement[]
  subscriptions Subscription[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model Entitlement {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  requestId String?
  request   Request?    @relation(fields: [requestId], references: [id])
  orderId   String?
  order     Order?      @relation(fields: [orderId], references: [id])
  type      ProductCode
  startsAt  DateTime
  expiresAt DateTime?
  meta      Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([requestId])
  @@map("entitlements")
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  plan             ProductCode
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  orderId          String             @unique
  order            Order              @relation(fields: [orderId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

model Notification {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  type      String
  payload   Json
  readAt    DateTime?
  channels  NotificationChannel[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([userId])
  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model Report {
  id              String       @id @default(cuid())
  reporterId      String
  reporter        User         @relation("ReportReporter", fields: [reporterId], references: [id])
  targetUserId    String?
  targetUser      User?        @relation("ReportTargetUser", fields: [targetUserId], references: [id])
  targetRequestId String?
  reason          String
  status          ReportStatus @default(OPEN)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([reporterId])
  @@index([status])
  @@map("reports")
}

// One online business card per user (vaqt.me/<username>).
model Card {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // One of CARD_TEMPLATES in @vaqt/shared (validated there, not a DB enum,
  // so adding a template needs no migration).
  template       String   @default("tile")
  // Owner consent to publish the phone number on the public card.
  showPhone      Boolean  @default(false)
  // Booking switch and rules (hours/leave days live in their own tables).
  bookingEnabled Boolean  @default(false)
  minNoticeHours Int      @default(2)
  maxDaysAhead   Int      @default(30)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("cards")
}

// Messenger/social links shown on the back of the card. `kind` is one of
// LINK_KINDS in @vaqt/shared; `value` is the canonical handle/number/URL.
model ContactLink {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String
  value  String
  order  Int    @default(0)

  @@unique([userId, kind])
  @@index([userId, order])
  @@map("contact_links")
}

// A kind of session a provider offers (e.g. 15-minute intro, 60-minute
// consultation). Never hard-deleted once bookings exist: deactivated instead,
// so old bookings keep a valid reference.
model ServiceType {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  // One of SERVICE_MODES in @vaqt/shared.
  mode            String
  note            String?
  isActive        Boolean   @default(true)
  order           Int       @default(0)
  bookings        Booking[]

  @@index([userId, order])
  @@map("service_types")
}

// Weekly working window in Iran local time. weekday: 0=Sunday … 6=Saturday
// (Date#getDay); minutes are from local midnight. A day may have several
// non-overlapping windows (e.g. 9-12 and 14-17).
model AvailabilityRule {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday     Int
  startMinute Int
  endMinute   Int

  @@index([userId, weekday])
  @@map("availability_rules")
}

// A whole Iran calendar day the provider is unavailable (leave, holiday).
model AvailabilityException {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'YYYY-MM-DD' in Iran local time.
  date   String

  @@unique([userId, date])
  @@map("availability_exceptions")
}

model Booking {
  id               String      @id @default(cuid())
  providerId       String
  provider         User        @relation("BookingProvider", fields: [providerId], references: [id], onDelete: Cascade)
  bookerId         String
  booker           User        @relation("BookingBooker", fields: [bookerId], references: [id], onDelete: Cascade)
  serviceId        String
  service          ServiceType @relation(fields: [serviceId], references: [id])
  // Snapshot so later edits to the service never rewrite history.
  serviceName      String
  durationMinutes  Int
  startAt          DateTime
  endAt            DateTime
  // One of BOOKING_STATUSES in @vaqt/shared.
  status           String      @default("PENDING")
  bookerName       String
  note             String?
  // Unguessable token for the no-login booking page (/b/<token>).
  cancelToken      String      @unique
  cancelledBy      String?
  decidedAt        DateTime?
  // Set once each reminder has been claimed for sending (idempotent scan).
  reminder24SentAt DateTime?
  reminder1SentAt  DateTime?
  createdAt        DateTime    @default(now())

  @@index([providerId, startAt])
  @@index([bookerId, startAt])
  @@map("bookings")
}

// Links a user to a chat on a messenger (today only "bale") so the platform
// can notify them there. One binding per user per platform, and one user per
// chat, so a chat can never receive another account's bookings.
model MessengerBinding {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String
  chatId    String
  createdAt DateTime @default(now())

  @@unique([userId, platform])
  @@unique([platform, chatId])
  @@map("messenger_bindings")
}

// Anonymous interaction counters for a card (no IP, no user agent stored).
// type is one of CARD_EVENT_TYPES in @vaqt/shared; source is where the visit
// came from (qr-card, qr-office, ..., or "direct").
model CardEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  source    String?
  linkKind  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("card_events")
}

// A card kept in someone's wallet. "exchanged" rows are created in both
// directions when two people swap cards.
model SavedCard {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation("WalletOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  cardUserId String
  cardUser   User     @relation("WalletCard", fields: [cardUserId], references: [id], onDelete: Cascade)
  source     String   @default("saved")
  createdAt  DateTime @default(now())

  @@unique([ownerId, cardUserId])
  @@index([ownerId, createdAt])
  @@map("saved_cards")
}

// Runtime configuration edited from the admin panel (SMS provider, Bale bot,
// SMS templates...). Secret values are stored encrypted (AES-256-GCM, key
// derived from APP_SECRET); the panel never reads them back.
model AppSetting {
  key         String   @id
  value       String
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("app_settings")
}
